{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões do notch e da janela de configurações",
  "windows": ["notch", "configuracoes"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "store:default",
    "opener:default",
    "notification:default",
    "autostart:default",
    "drag:default"
  ]
}
